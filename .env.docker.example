# Required: protects every /v1/* endpoint. Use a long random value.
MAI_API_KEY=replace-with-a-long-random-token

# The local source tree made available to the agent. Relative paths are
# resolved from compose.yaml.
MAI_WORKSPACE=.
MAI_API_PUBLISHED_PORT=3141

# Pick one provider declared in providers.json and configure its key.
API_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional provider overrides.
OPENAI_MODEL=
OPENAI_BASE_URL=
GEMINI_MODEL=
GEMINI_BASE_URL=

# Docker deployment deliberately preserves the complete agent feature set.
MAI_API_ALLOW_WRITE=true
MAI_API_ALLOW_SHELL=true
MAI_API_APPROVAL_MODE=auto
MAI_ALLOW_SHELL=true
