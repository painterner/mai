# Copy this file to .env and fill in your key.
#
# provider can be "gemini" (default) or "openai" — "openai" also covers any
# OpenAI-compatible server (vLLM, Ollama's OpenAI-compat mode, LM Studio,
# most third-party proxies) via OPENAI_BASE_URL.
API_PROVIDER=gemini

# --- Gemini (used when API_PROVIDER=gemini) ---
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenAI / OpenAI-compatible (used when API_PROVIDER=openai) ---
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional, provider-independent overrides — defaults shown:
# MAI_MAX_TOKENS=8192
# MAI_TEMPERATURE=0.7

# Set to false to disable the run_command tool entirely (no shell access at all).
# MAI_ALLOW_SHELL=true

# Override if the mai-sandbox binary isn't found automatically (see README).
# MAI_SANDBOX_BIN=/path/to/mai-sandbox

# Override if the GUI binary isn't found automatically for the /gui command.
# MAI_GUI_BIN=/path/to/mai-gui
