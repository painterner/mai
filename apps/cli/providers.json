[
  {
    "name": "gemini",
    "kind": "gemini",
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "apiKeyEnv": "GEMINI_API_KEY",
    "model": "gemini-2.5-flash"
  },
  {
    "name": "chat",
    "kind": "openai",
    "type": "openai-compatible",
    "wireApi": "chat-completions",
    "baseUrl": "https://chat.painterner.me/api/v1",
    "auth": {
      "type": "env",
      "env": "CHATNOTE_API_KEY"
    },
    "capabilities": {},
    "model": "deepseek-v4-flash"
  },
  {
    "name": "ai-gateway",
    "kind": "openai",
    "type": "openai-compatible",
    "wireApi": "chat-completions",
    "baseUrl": "https://ai-gateway.painterner.me/v1",
    "auth": {
      "type": "env",
      "env": "AI_GATEWAY_API_KEY"
    },
    "capabilities": {
      "reasoning": true
    },
    "model": "gpt-5.6-sol"
  },
  {
    "name": "openai",
    "kind": "openai",
    "type": "openai",
    "wireApi": "responses",
    "baseUrl": "https://api.openai.com/v1",
    "auth": {
      "type": "codex-login",
      "chatgptBaseUrl": "https://chatgpt.com/backend-api/codex"
    },
    "capabilities": {
      "webSearch": true,
      "reasoning": true,
      "imageGeneration": false
    },
    "model": "gpt-5.6-sol"
  }
]
