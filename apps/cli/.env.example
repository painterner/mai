# Copy this file to .env and fill in your key(s).
#
# The list of providers Mai can use lives in providers.json (same directory
# as this file), not here. New entries can separately declare provider
# `type`, `wireApi`, `auth`, and hosted-tool `capabilities`; the legacy
# kind/apiKeyEnv shape remains supported. See providers.json /
# providers.example.json (more providers: Groq, DeepSeek, OpenRouter, a
# local Ollama/vLLM server, ...) for the shape and how to add your own.
#
# API_PROVIDER picks which providers.json entry is active at startup by
# "name" (defaults to the first entry if unset or unmatched); /model also
# switches providers/models at runtime without touching this file.
API_PROVIDER=gemini

# --- Gemini (used when API_PROVIDER=gemini) ---
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenAI (used when API_PROVIDER=openai) ---
# The shipped OpenAI provider uses an existing Codex login. Run `mai`, then
# `/login`; OPENAI_API_KEY remains a non-interactive fallback for Docker/CI.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Any providers you add to providers.json need their apiKeyEnv var here
# too, e.g. for providers.example.json's extra entries:
# GROQ_API_KEY=your-groq-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# OLLAMA_API_KEY=anything-nonempty   # local servers usually ignore the value

# Optional, provider-independent overrides — defaults shown:
# MAI_MAX_TOKENS=8192
# MAI_TEMPERATURE=0.7

# Set to false to disable the run_command tool entirely (no shell access at all).
# MAI_ALLOW_SHELL=true

# Agent approval mode: auto (default, no prompts), safe (risk rules), or
# manual (ask for every non-forbidden tool call).
# MAI_API_APPROVAL_MODE=auto

# Override if the mai-sandbox binary isn't found automatically (see README).
# MAI_SANDBOX_BIN=/path/to/mai-sandbox

# Override if the GUI binary isn't found automatically for the /gui command.
# MAI_GUI_BIN=/path/to/mai-gui
